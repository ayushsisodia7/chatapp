# CometChat credentials — get these from your CometChat Dashboard
COMETCHAT_APP_ID=your_app_id_here
COMETCHAT_REGION=us        # e.g. us, eu, in
COMETCHAT_API_KEY=your_api_key_here

# Optional: webhook signature secret (set in CometChat Dashboard → Webhooks)
# When set, the /webhook/before-message endpoint will verify the signature
COMETCHAT_WEBHOOK_SECRET=

# Port for the backend server
PORT=4000